{
  "name": "pascal-css",
  "version": "4.2.0",
  "description": "A modern, lightweight, utility-first CSS library with PascalCase naming, a full responsive layout engine, and OKLCH colors",
  "main": "pascal-css.css",
  "style": "pascal-css.css",
  "files": [
    "pascal-css.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "build:important:subset": "node build.js --important-mode=subset",
    "build:important:opt-in": "node build.js --important-mode=opt-in",
    "watch": "node build.js --watch",
    "health": "node health-check.js",
    "health:strict": "node health-check.js --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gae4it/pascal-css.git"
  },
  "keywords": [
    "css",
    "utility-first",
    "pascalcase",
    "responsive",
    "responsive-engine",
    "oklch",
    "modern-css",
    "css-framework",
    "lightweight",
    "cdn",
    "static-css"
  ],
  "author": "Gae4it",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gae4it/pascal-css/issues"
  },
  "homepage": "https://pascalcss.netlify.app/",
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "cssnano": "^6.0.3",
    "postcss": "^8.4.33"
  }
}
